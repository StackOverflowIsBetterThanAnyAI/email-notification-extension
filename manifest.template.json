{
    "manifest_version": 3,
    "name": "Gmail Notifier",
    "short_name": "Gmail Notifier",
    "description": "Shows a desktop notification when a new email arrives in your Gmail inbox.",
    "version": "1.0.0",
    "minimum_chrome_version": "120",
    "key": "${EXTENSION_PUBLIC_KEY}",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_title": "Gmail Notifier",
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png"
        }
    },
    "background": {
        "service_worker": "src/background.js",
        "type": "module"
    },
    "permissions": ["identity", "alarms", "notifications", "storage"],
    "host_permissions": [
        "https://gmail.googleapis.com/*",
        "https://oauth2.googleapis.com/*"
    ],
    "oauth2": {
        "client_id": "${GOOGLE_CLIENT_ID}",
        "scopes": ["https://www.googleapis.com/auth/gmail.metadata"]
    },
    "content_security_policy": {
        "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src https://gmail.googleapis.com https://oauth2.googleapis.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
}
